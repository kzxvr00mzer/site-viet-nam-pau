# Le Vietnam Pau — réglages serveur (hébergement OVH, Apache)
RewriteEngine On

# 1. Toujours en https et sans « www »
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://viet-nam-pau.fr%{REQUEST_URI} [L,R=301]

# 2. Anciennes pages WordPress vers les sections du nouveau site (garde le référencement)
RewriteCond %{QUERY_STRING} (^|&)page_id=212(&|$)
RewriteRule ^$ https://viet-nam-pau.fr/#carte? [NE,L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page_id=56(&|$)
RewriteRule ^$ https://viet-nam-pau.fr/#acces? [NE,L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page_id=[0-9]+(&|$)
RewriteRule ^$ https://viet-nam-pau.fr/? [L,R=301]
RewriteRule ^wp-content/uploads/2026/11/Carte-a-emporter-14-11-26\.pdf$ /docs/carte-a-emporter.pdf [L,R=301]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|feed)(/.*)?$ / [L,R=301]

# 3. Compression et mise en cache (site plus rapide, mieux classé)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

Options -Indexes
